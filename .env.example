# Konfiguracja Supabase (dev = projekt STAGING, nie prod!)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sunshine API (backend Mamamia)
# Token do nagłówka X-Sunshine-Token — dla devu token BETA
VITE_SUNSHINE_TOKEN=your_sunshine_token_here
# Cel proxy vite dla /api/sunshine/* — domyślnie backend.beta.mamamia.app;
# prod WYŁĄCZNIE jawnie:
# VITE_API_PROXY_TARGET=https://backend.prod.mamamia.app

# Konfiguracja Twilio (opcjonalna lokalnie — realne połączenia!)
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
VITE_TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Instrukcje:
# 1. Skopiuj ten plik jako .env i uzupełnij wartości
# 2. Supabase URL i Anon Key: Project Settings → API (projekt STAGING dla devu)
# 3. Twilio: Console → Account Info / Phone Numbers
# 4. NIE trzymaj tu SUPABASE_SERVICE_ROLE_KEY — service role żyje tylko w Edge Functions
